{
  "name": "florecer-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "TZ=Europe/Madrid vitest run",
    "test:watch": "TZ=Europe/Madrid vitest",
    "preview": "vite preview",
    "test:rls": "FLORECER_REMOTE_TESTS=1 vitest run --config tests/rls/vitest.config.ts --mode test",
    "e2e": "playwright test -c tests/e2e/playwright.config.ts --project=local-mobile --project=local-desktop",
    "e2e:remote": "FLORECER_REMOTE_TESTS=1 playwright test -c tests/e2e/playwright.config.ts --project=remote"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "@tanstack/react-query": "^5.107.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.90.0",
    "sass": "^1.108.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.0"
  }
}
