# Solo configuración. NO pegar claves reales en este archivo ni commitear .env.local
# Cliente (se incluyen en el bundle; deben ser claves publicables, RLS obligatoria)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Solo para `pnpm test:rls` y E2E, en .env.test.local (ignorado por git).
# Cuentas de prueba sintéticas registradas por el registro público; nunca la cuenta real.
# TEST_A_EMAIL=
# TEST_A_PASSWORD=
# TEST_B_EMAIL=
# TEST_B_PASSWORD=

# FASE 2: exclusivamente variables de entorno del backend Vercel Function, sin prefijo VITE_
NVIDIA_API_KEY=
NVIDIA_MODEL=
# Configurar solo si documentación oficial del proveedor lo requiere
NVIDIA_API_BASE_URL=
